# Gemini API key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Optional: use Vertex AI instead of an API key
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Models (defaults shown — every agent uses the Gemini 2.5 family)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
# INTERVIEWER_VOICE=Charon

# Mock interview
# INTERVIEW_QUESTION_COUNT=7      # 5 to 10
# VOICE_MODE=live                 # live = Gemini Live API, turn = turn-by-turn fallback

# Where the SQLite database and uploaded resume are stored
# MENTOR_DATA_DIR=data
